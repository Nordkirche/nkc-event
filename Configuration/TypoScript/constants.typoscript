
plugin.tx_nkcevent {
    settings {
        # cat=plugin.tx_nkcevent/file; type=string; label=Page ID Event Detail
        pidEventSingle = 152

        # cat=plugin.tx_nkcevent/file; type=string; label=Page ID Event Liste
        pidEventList = 65

        # cat=plugin.tx_nkcevent/links; type=string; label=Kurzlink Veranstaltung (Seite mit Plugin "Veranstaltungen: Umleitung")
        eventShortLink = /event/?nkce=

        # cat=plugin.tx_nkcevent/icons; type=string; label=Karten-Icon Veranstaltung (%s = Typ)
        eventIconName = EXT:nkc_base/Resources/Public/MapIcons/event_%s.svg

        # cat=plugin.tx_nkcevent/categories; type=string; label=NAPI-Kategorien für digitale Veranstaltungen
        digitalEventCategoryId = 606,647

        # cat=plugin.tx_nkcevent/categories; type=string; label=NAPI-Kategorien für hybride Veranstaltungen
        hybridEventCategoryId = 646

        # cat=plugin.tx_nkcevent/institution; type=string; label=Institution(en) der Site (NAPI-IDs, Komma getrennt): für "Nur Veranstaltungen der Institution dieser Site"
        siteInstitutions =

        # cat=plugin.tx_nkcevent/layout; type=string; label=Standard-Layout der Listen (z. B. Compact), wenn im Plugin keins gewählt ist
        templateLayout =

    }
}

plugin.tx_nkcevent_main {
    view {
        # cat=plugin.tx_nkcevent_main/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:nkc_event/Resources/Private/Templates/
        # cat=plugin.tx_nkcevent_main/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:nkc_event/Resources/Private/Partials/
        # cat=plugin.tx_nkcevent_main/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:nkc_event/Resources/Private/Layouts/
    }
    persistence {
        # cat=plugin.tx_nkcevent_main//a; type=string; label=Default storage PID
        storagePid =
    }

    # cat=plugin.tx_nkcevent_main//a; type=string; label=AJAX type num
    ajaxTypeNum = 56281
}


plugin.tx_nkcevent_map {
    view {
        # cat=plugin.tx_nkcevent_map/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:nkc_event/Resources/Private/Templates/
        # cat=plugin.tx_nkcevent_map/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:nkc_event/Resources/Private/Partials/
        # cat=plugin.tx_nkcevent_map/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:nkc_event/Resources/Private/Layouts/
    }
    persistence {
        # cat=plugin.tx_nkcevent_map//a; type=string; label=Default storage PID
        storagePid =
    }

    # cat=plugin.tx_nkcevent_map//a; type=string; label=AJAX type num
    ajaxTypeNum = 56282
}

