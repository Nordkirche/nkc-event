
plugin.tx_nkcevent {
    view {
        templateRootPaths.0 = EXT:nkc_event/Resources/Private/Templates/
        templateRootPaths.1 = {$plugin.tx_nkcevent_main.view.templateRootPath}
        partialRootPaths.0 = EXT:nkc_base/Resources/Private/Partials/
        partialRootPaths.5 = EXT:nkc_event/Resources/Private/Partials/
        partialRootPaths.10 = {$plugin.tx_nkcevent_main.view.partialRootPath}
        layoutRootPaths.0 = EXT:nkc_event/Resources/Private/Layouts/
        layoutRootPaths.1 = {$plugin.tx_nkcevent_main.view.layoutRootPath}
    }
    persistence {
        storagePid = {$plugin.tx_nkcevent_main.persistence.storagePid}
        #recursive = 1
    }
    mvc {
        callDefaultActionIfActionCantBeResolved = 1
    }

    settings {
        socialMediaChannels {
            0 = twitter
            1 = facebook
            2 = xing
            3 = instagram
            4 = pinterest
            5 = flickr
        }

        eventIconName = {$plugin.tx_nkcevent.settings.eventIconName}

        monthIcon = EXT:nkc_base/Resources/Public/Icons/icon_calendar_month.svg

        downloadIcon = EXT:nkc_base/Resources/Public/Icons/link_download.svg

        downloadBaseUrl = https://www.nordkirche.de/

        # Der Kurzlink wird für Links von außen verwendet.
        # Unter diesem Pfad sollte das Plugin mit der Action redirect liegen.
        # Es leitet dann auf die Event-Detail Ansicht um
        shortLink = {$plugin.tx_nkcevent.settings.eventShortLink}

        # NAPI category Id für digitale Veranstaltungen
        digitalEventCategoryId = {$plugin.tx_nkcevent.settings.digitalEventCategoryId}

        # NAPI category Id für hybride Veranstaltungen
        hybridEventCategoryId = {$plugin.tx_nkcevent.settings.hybridEventCategoryId}

        mapping {
            eventType {
                church_service = Gottesdienst
                digital-church_service = Gottesdienst (digital)
                hybrid-church_service = Gottesdienst (hybrid)

                committee = Gremien
                digital-committee = Gremien (digital)
                hybrid-committee = Gremien (hybrid)

                default = Gemeindeleben
                digital-default = Gemeindeleben (digital)
                hybrid-default = Gemeindeleben (hybrid)

                edu = Bildung
                digital-edu = Bildung (digital)
                hybrid-edu = Bildung (hybrid)

                event = Gemeindeleben
                digital-event = Gemeindeleben (digital)
                hybrid-event = Gemeindeleben (hybrid)

                leisure = Freizeit
                digital-leisure = Freizeit (digital)
                hybrid-leisure = Freizeit (hybrid)

                music = Konzerte
                digital-music = Konzerte (digital)
                hybrid-music = Konzerte (hybrid)

                spirituality = Spiritualitaet
                digital-spirituality = Spiritualitaet (digital)
                hybrid-spirituality = Spiritualitaet (hybrid)

                base = Gemeindeleben
                digital-base = Gemeindeleben (digital)
                hybrid-base = Gemeindeleben (hybrid)

            }

            eventIcon {
                church_service = gottesdienst
                committee = gremien
                default = gemeindeleben
                edu = bildung
                event = gemeindeleben
                leisure = freizeit
                music = konzerte
                spirituality = spiritualitaet
                base = gemeindeleben

                digital-church_service = digital-gottesdienst
                digital-committee = digital-gremien
                digital-default = digital-gemeindeleben
                digital-edu = digital-bildung
                digital-event = digital-gemeindeleben
                digital-leisure = digital-freizeit
                digital-music = digital-konzerte
                digital-spirituality = digital-spiritualitaet
                digital-base = digital-gemeindeleben

                hybrid-church_service = hybrid-gottesdienst
                hybrid-committee = hybrid-gremien
                hybrid-default = hybrid-gemeindeleben
                hybrid-edu = hybrid-bildung
                hybrid-event = hybrid-gemeindeleben
                hybrid-leisure = hybrid-freizeit
                hybrid-music = hybrid-konzerte
                hybrid-spirituality = hybrid-spiritualitaet
                hybrid-base = hybrid-gemeindeleben

            }
        }

        paginate {
            itemsPerPage = 25
        }

        flexformDefault {
            pidSingle = {$plugin.tx_nkcevent.settings.pidEventSingle}
            pidList = {$plugin.tx_nkcevent.settings.pidEventList}
        }

        maxItems = 25

        # Institution(en) der Site, für "Nur Veranstaltungen der Institution dieser Site"
        siteInstitutions = {$plugin.tx_nkcevent.settings.siteInstitutions}

        # Layout der Listen, wenn im Plugin keins gewählt ist (Partial Event/Teaser/<Layout>)
        templateLayout = {$plugin.tx_nkcevent.settings.templateLayout}

        ajaxTypeNum = {$plugin.tx_nkcevent_map.ajaxTypeNum}

        ajaxListTypeNum = {$plugin.tx_nkcevent_main.ajaxTypeNum}

        relativeFilterDates {

            1 {
                time = 604800
                label = filterDate.nextWeek
            }
            2 {
                time = 2419200
                label = filterDate.nextFourWeek
            }
            3 {
                time = 7257600
                label = filterDate.nextQuarter
            }
            4 {
                time = 14515200
                label = filterDate.nextHalfYear
            }
        }

    }
}

plugin.tx_nkcevent_show < plugin.tx_nkcevent
plugin.tx_nkcevent_list < plugin.tx_nkcevent
plugin.tx_nkcevent_calendar < plugin.tx_nkcevent
plugin.tx_nkcevent_calendar._CSS_DEFAULT_STYLE (
    .nkc-calendar__header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .nkc-calendar__nav { font-size: 1.5rem; line-height: 1; padding: .25rem .75rem; text-decoration: none; }
    .nkc-calendar__sheet { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .nkc-calendar__caption { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .nkc-calendar__sheet th, .nkc-calendar__day { border: 1px solid #ddd; padding: .25rem; vertical-align: top; }
    .nkc-calendar__day { height: 5rem; overflow-wrap: anywhere; }
    .nkc-calendar__day--outside { background: #f6f6f6; }
    .nkc-calendar__day--today .nkc-calendar__date { font-weight: bold; text-decoration: underline; }
    .nkc-calendar__events { list-style: none; margin: .25rem 0 0; padding: 0; font-size: .85em; }
    .nkc-calendar__event + .nkc-calendar__event { margin-top: .25rem; }
    .nkc-calendar__time { display: block; color: #666; }
    [data-nkc-calendar][aria-busy="true"] { opacity: .6; }
    @media (max-width: 640px) {
        .nkc-calendar__sheet thead { display: none; }
        .nkc-calendar__sheet, .nkc-calendar__sheet tbody, .nkc-calendar__sheet tr, .nkc-calendar__day { display: block; width: auto; height: auto; }
        .nkc-calendar__day--outside, .nkc-calendar__day:not(.nkc-calendar__day--events) { display: none; }
    }
)
plugin.tx_nkcevent_searchform < plugin.tx_nkcevent
plugin.tx_nkcevent_redirect < plugin.tx_nkcevent

plugin.tx_nkcevent_map {
    view {
        templateRootPaths.0 = EXT:nkc_event/Resources/Private/Templates/
        templateRootPaths.1 = {$plugin.tx_nkcevent_map.view.templateRootPath}
        partialRootPaths.0 = EXT:nkc_base/Resources/Private/Partials/
        partialRootPaths.5 = EXT:nkc_event/Resources/Private/Partials/
        partialRootPaths.10 = {$plugin.tx_nkcevent_map.view.partialRootPath}
        layoutRootPaths.0 = EXT:nkc_event/Resources/Private/Layouts/
        layoutRootPaths.1 = {$plugin.tx_nkcevent_map.view.layoutRootPath}
    }
    persistence {
        storagePid = {$plugin.tx_nkcevent_map.persistence.storagePid}
        #recursive = 1
    }

    settings {

        eventIconName < plugin.tx_nkcevent.settings.eventIconName

        mapping < plugin.tx_nkcevent.settings.mapping

        digitalEventCategoryId < plugin.tx_nkcevent.settings.digitalEventCategoryId

        hybridEventCategoryId < plugin.tx_nkcevent.settings.hybridEventCategoryId

        siteInstitutions < plugin.tx_nkcevent.settings.siteInstitutions

        ajaxTypeNum = {$plugin.tx_nkcevent_map.ajaxTypeNum}

        ajaxListTypeNum = {$plugin.tx_nkcevent_main.ajaxTypeNum}

        monthIcon = EXT:nkc_base/Resources/Public/Icons/icon_calendar_month.svg

        maxItems = 50

        asyncLoadingMaxItems = 30

        paginate {
            itemsPerPage = 20
            insertAbove = 1
            insertBelow = 1
            templatePath =
            prevNextHeaderTags = 1
            maximumNumberOfLinks = 3
        }

        flexformDefault {
            pidSingle = {$plugin.tx_nkcevent.settings.pidEventSingle}
            pidList = {$plugin.tx_nkcevent.settings.pidEventList}
        }

    }
}

plugin.tx_nkcevent_maplist < plugin.tx_nkcevent_map


[request.getPageArguments() && request.getPageArguments().getPageType() == '{$plugin.tx_nkcevent_main.ajaxTypeNum}']
    lib.contentElement.settings.additionalConfig.plainResult = 1
[global]


ajaxEvents = PAGE
ajaxEvents {
    typeNum = {$plugin.tx_nkcevent_main.ajaxTypeNum}

    config {
        disableAllHeaderCode = 1
        disablePrefixComment = 1
    }

    10 = CONTENT
    10 {
        table = tt_content
        select.pidInList = this
        select.uidInList = ###UID###
        select.markers {
            UID.data = GP:uid
            UID.intval = 1
        }
    }
}

[request.getPageArguments() && request.getPageArguments().getPageType() == '{$plugin.tx_nkcevent_map.ajaxTypeNum}']
    lib.contentElement.settings.additionalConfig.plainResult = 1
[global]

mapEventData = PAGE
mapEventData {
    typeNum = {$plugin.tx_nkcevent_map.ajaxTypeNum}

    config {
        disableAllHeaderCode = 1
        disablePrefixComment = 1
        additionalHeaders.10 {
            header = Content-Type: application/json; charset=utf-8
            replace = 1
        }
    }

    10 = CONTENT
    10 {
        table = tt_content
        select.pidInList = this
        select.uidInList = ###UID###
        select.markers {
            UID.data = GP:uid
            UID.intval = 1
        }
    }
}


# Upcoming events in the institution business card of nkc_address
plugin.tx_nkcaddress_institution.view.partialRootPaths.7 = EXT:nkc_event/Resources/Private/Partials/NkcAddress/
