<T3DataStructure>
	<sheets>
		<sDEF>
			<ROOT>
					<sheetTitle>Funktion</sheetTitle>
				<type>array</type>
				<el>

					<settings.flexform.stream>
							<label>Marker sukzessive nachladen</label>
							<config>
								<type>check</type>
							</config>
					</settings.flexform.stream>

					<settings.flexform.eventTypes>
							<label>Veranstaltungen diese Typs darstellen</label>
							<exclude>1</exclude>
							<config>
								<type>select</type>
								<renderType>selectMultipleSideBySide</renderType>
								<minitems>0</minitems>
								<maxitems>20</maxitems>
								<items>
									<numIndex index="0">
										<label>Gottesdienste</label>
										<value>church_service</value>
									</numIndex>
									<numIndex index="1">
										<label>Gremium</label>
										<value>committee</value>
									</numIndex>
									<numIndex index="2">
										<label>Sonstiges</label>
										<value>default</value>
									</numIndex>
									<numIndex index="3">
										<label>Bildung</label>
										<value>edu</value>
									</numIndex>
									<numIndex index="4">
										<label>Gemeindeleben</label>
										<value>event</value>
									</numIndex>
									<numIndex index="5">
										<label>Freizeit</label>
										<value>leisure</value>
									</numIndex>
									<numIndex index="6">
										<label>Konzert</label>
										<value>music</value>
									</numIndex>
									<numIndex index="7">
										<label>Spiritualität</label>
										<value>spirituality</value>
									</numIndex>
								</items>
							</config>
					</settings.flexform.eventTypes>

					<settings.flexform.institutionCollection>
							<label>Veranstaltungen dieser Institutionen darstellen</label>
							<config>
								<type>user</type>
								<renderType>napiItemSelector</renderType>
								<allowed>institution</allowed>
								<minItems>0</minItems>
								<maxItems>99</maxItems>
								<size>10</size>
							</config>
					</settings.flexform.institutionCollection>

					<settings.flexform.eventLocation>
							<label>Veranstaltungen an diesem Ort darstellen</label>
							<config>
								<type>user</type>
								<renderType>napiItemSelector</renderType>
								<allowed>eventLocation</allowed>
								<minItems>0</minItems>
								<maxItems>1</maxItems>
								<size>1</size>
							</config>
					</settings.flexform.eventLocation>

					<settings.flexform.targetGroupCollection>
							<label>Veranstaltungen für diese Zielgruppen darstellen</label>
							<config>
								<type>select</type>
								<renderType>selectMultipleSideBySide</renderType>
								<itemsProcFunc>Nordkirche\NkcBase\CustomField\SelectObject->createNapiItems</itemsProcFunc>
								<allowed>targetGroup</allowed>
								<minItems>0</minItems>
								<maxItems>99</maxItems>
								<size>10</size>
							</config>
					</settings.flexform.targetGroupCollection>

					<settings.flexform.categories>
							<label>Veranstaltungen mit diesen Kategorien darstellen</label>
							<exclude>1</exclude>
							<config>
								<type>select</type>
								<renderMode>tree</renderMode>
								<renderType>selectTree</renderType>
								<treeConfig>
									<parentField>parent</parentField>
									<appearance>
										<collapseAll>TRUE</collapseAll>
										<showHeader>TRUE</showHeader>
									</appearance>
								</treeConfig>
								<foreign_table>sys_category</foreign_table>
								<size>10</size>
								<autoSizeMax>20</autoSizeMax>
								<minitems>0</minitems>
								<maxitems>20</maxitems>
							</config>
					</settings.flexform.categories>

					<settings.flexform.categoryOperator>
							<label>Kategorie-Operator</label>
							<exclude>1</exclude>
							<config>
								<type>select</type>
								<renderType>selectSingle</renderType>
								<items>
									<numIndex index="0">
										<label>ODER: eine der gewählen Kategorien muss gesetzt sein</label>
										<value>OR</value>
									</numIndex>
									<numIndex index="1">
										<label>UND: alle Kategorien müssen gesetzt sein</label>
										<value>AND</value>
									</numIndex>
								</items>
							</config>
					</settings.flexform.categoryOperator>

					<settings.flexform.dateFrom>
							<label>Zeitraum von</label>
							<config>
								<type>datetime</type>
								<format>date</format>
							</config>
					</settings.flexform.dateFrom>

					<settings.flexform.dateTo>
							<label>Zeitraum bis</label>
							<config>
								<type>datetime</type>
								<format>date</format>
							</config>
					</settings.flexform.dateTo>

                    <settings.flexform.numDays>
                            <label>Die folgenden x Tage</label>
                            <config>
                                <type>input</type>
                                <size>3</size>
                            </config>
                    </settings.flexform.numDays>

					<settings.flexform.geosearch>
							<label>Auswahl über Geodaten einschränken</label>
							<onChange>reload</onChange>
							<config>
								<type>check</type>
								<default>0</default>
							</config>
					</settings.flexform.geosearch>

					<settings.flexform.latitude>
							<label>Breitengrad</label>
							<config>
								<type>input</type>
								<size>5</size>
								<default></default>
							</config>
							<displayCond>FIELD:settings.flexform.geosearch:=:1</displayCond>
					</settings.flexform.latitude>

					<settings.flexform.longitude>
							<label>Längengrad</label>
							<config>
								<type>input</type>
								<size>5</size>
								<default></default>
							</config>
							<displayCond>FIELD:settings.flexform.geosearch:=:1</displayCond>
					</settings.flexform.longitude>

					<settings.flexform.radius>
							<label>Umkreis (km)</label>
							<config>
								<type>input</type>
								<size>5</size>
								<default></default>
							</config>
							<displayCond>FIELD:settings.flexform.geosearch:=:1</displayCond>
					</settings.flexform.radius>
				</el>
			</ROOT>
		</sDEF>
		<sTemplate>
			<ROOT>
					<sheetTitle>Ausgabe</sheetTitle>
				<type>array</type>
				<el>
					<settings.flexform.header>
							<label>Überschrift für Suchformular (optional)</label>
							<config>
								<type>input</type>
								<size>30</size>
								<default></default>
							</config>
					</settings.flexform.header>

					<settings.flexform.header_layout>
							<label>Layout</label>
							<config>
								<type>select</type>
								<renderType>selectSingle</renderType>
								<items>
									<numIndex index="0">
										<label>Überschrift 1</label>
										<value>1</value>
									</numIndex>
									<numIndex index="1">
										<label>Überschrift 2</label>
										<value>2</value>
									</numIndex>
									<numIndex index="2">
										<label>Überschrift 3</label>
										<value>3</value>
									</numIndex>
								</items>
								<default>2</default>
							</config>
					</settings.flexform.header_layout>


					<settings.flexform.maxItems>
							<label>Maximale Anzahl</label>
							<config>
								<type>input</type>
								<size>5</size>
								<default></default>
							</config>
					</settings.flexform.maxItems>

					<settings.flexform.paginate.mode>
							<label>Art der Paginierung</label>
							<onChange>reload</onChange>
							<config>
								<type>select</type>
								<renderType>selectSingle</renderType>
								<items>
									<numIndex index="0">
										<label>Keine Paginierung</label>
										<value>0</value>
									</numIndex>
									<numIndex index="1">
										<label>Button zum Laden weiterer Elemente</label>
										<value>1</value>
									</numIndex>
									<numIndex index="2">
										<label>Blätternavigation einblenden</label>
										<value>2</value>
									</numIndex>
								</items>
							</config>
					</settings.flexform.paginate.mode>

					<settings.flexform.paginate.itemsPerPage>
							<label>Anzahl Elemente pro Seite</label>
							<config>
								<type>input</type>
								<size>5</size>
								<default>25</default>
							</config>
							<displayCond>FIELD:settings.flexform.paginate.mode:!=:0</displayCond>
					</settings.flexform.paginate.itemsPerPage>

					<settings.flexform.paginate.insertAbove>
							<label>Paginierung über der Liste anzeigen</label>
							<config>
								<type>check</type>
								<default>0</default>
							</config>
							<displayCond>FIELD:settings.flexform.paginate.mode:=:2</displayCond>
					</settings.flexform.paginate.insertAbove>

					<settings.flexform.paginate.insertBelow>
							<label>Paginierung unter der Liste anzeigen</label>
							<config>
								<type>check</type>
								<default>1</default>
							</config>
							<displayCond>FIELD:settings.flexform.paginate.mode:=:2</displayCond>
					</settings.flexform.paginate.insertBelow>

					<settings.flexform.paginate.maximumNumberOfLinks>
							<label>Anzahl Links in Paginierung</label>
							<config>
								<type>input</type>
								<size>5</size>
								<default>5</default>
							</config>
							<displayCond>FIELD:settings.flexform.paginate.mode:=:2</displayCond>
					</settings.flexform.paginate.maximumNumberOfLinks>

					<settings.flexform.showMap>
							<label>Zeige Karte mit Veranstaltungen</label>
							<config>
								<type>check</type>
								<default>0</default>
							</config>
					</settings.flexform.showMap>

					<settings.flexform.showFilter>
							<label>Nutzer sollen die Liste filtern können</label>
							<config>
								<type>check</type>
								<default>0</default>
							</config>
					</settings.flexform.showFilter>

					<settings.flexform.errorMessage>
							<label>Ausgabe, wenn keine Veranstaltung gefunden (optional)</label>
							<config>
								<type>text</type>
								<rows>3</rows>
								<cols>40</cols>
							</config>
					</settings.flexform.errorMessage>

				</el>
			</ROOT>
		</sTemplate>
		<sFilter>
			<ROOT>
					<sheetTitle>Filter</sheetTitle>
				<type>array</type>

				<el>
					<settings.filter.cityCollection>
							<label>Orte (Namen durch Komma getrennt)</label>
							<config>
								<type>text</type>
								<rows>3</rows>
								<cols>40</cols>
							</config>
							<displayCond>FIELD:sTemplate.settings.flexform.showFilter:=:1</displayCond>
					</settings.filter.cityCollection>


					<settings.filter.institutionCollection>
							<label>Institutionen zu Orten</label>
							<config>
								<type>user</type>
								<renderType>napiItemSelector</renderType>
								<allowed>institution</allowed>
								<minItems>0</minItems>
								<maxItems>99</maxItems>
								<size>10</size>
							</config>
							<displayCond>FIELD:sTemplate.settings.flexform.showFilter:=:1</displayCond>
					</settings.filter.institutionCollection>

					<settings.filter.pidDateFilter>
							<label>Seite mit Datumsvorlagen</label>
							<config>
								<type>group</type>
								<allowed>pages</allowed>
								<size>1</size>
								<maxitems>1</maxitems>
								<minitems>0</minitems>
								<show_thumbs>1</show_thumbs>
							</config>
							<displayCond>FIELD:sTemplate.settings.flexform.showFilter:=:1</displayCond>
					</settings.filter.pidDateFilter>

					<settings.filter.categoryCollection>
							<label>Kategorien</label>
							<config>
								<type>group</type>
								<allowed>sys_category</allowed>
								<size>10</size>
								<maxitems>99</maxitems>
								<minitems>0</minitems>
								<show_thumbs>1</show_thumbs>
							</config>
							<displayCond>FIELD:sTemplate.settings.flexform.showFilter:=:1</displayCond>
					</settings.filter.categoryCollection>
				</el>
			</ROOT>
		</sFilter>
		<sPages>
			<ROOT>
					<sheetTitle>Seiten</sheetTitle>
				<type>array</type>

				<el>
					<settings.flexform.pidSingle>
							<label>Seite für Einzelansicht</label>
							<config>
								<type>group</type>
								<allowed>pages</allowed>
								<size>1</size>
								<maxitems>1</maxitems>
								<minitems>0</minitems>
								<show_thumbs>1</show_thumbs>
							</config>
					</settings.flexform.pidSingle>

					<settings.flexform.pidList>
							<label>Seite für Listenansicht</label>
							<config>
								<type>group</type>
								<allowed>pages</allowed>
								<size>1</size>
								<maxitems>1</maxitems>
								<minitems>0</minitems>
								<show_thumbs>1</show_thumbs>
							</config>
					</settings.flexform.pidList>
				</el>
			</ROOT>
		</sPages>
	</sheets>
</T3DataStructure>
