<T3DataStructure>
	<sheets>
		<sTemplate>
			<ROOT>
					<sheetTitle>Ausgabe</sheetTitle>
				<type>array</type>
				<el>

					<settings.flexform.searchFormTemplate>
							<label>Art des Suchformulars</label>
							<onChange>reload</onChange>
							<config>
								<type>select</type>
								<renderType>selectSingle</renderType>
								<items>
									<numIndex index="0">
										<label>Normale Version</label>
										<value>Default</value>
									</numIndex>
									<numIndex index="1">
										<label>Service Flap: Veranstaltungen</label>
										<value>ServiceFlap</value>
									</numIndex>
									<numIndex index="2">
										<label>Service Flap: Kirchenmusik</label>
										<value>ServiceFlapConcerts</value>
									</numIndex>
                                    <numIndex index="3">
                                    	<label>Gottesdienste (z.B. zur Verwendung im Teaser für die Gottesdienstsuche)</label>
                                    	<value>ChurchServices</value>
                                    </numIndex>
								</items>
								<default>Default</default>
							</config>
					</settings.flexform.searchFormTemplate>

					<settings.flexform.header>
							<label>Überschrift für Suchformular (optional)</label>
							<config>
								<type>input</type>
								<size>30</size>
								<default></default>
							</config>
							<displayCond>FIELD:settings.flexform.searchFormTemplate:=:Default</displayCond>
					</settings.flexform.header>

					<settings.flexform.header_layout>
							<label>Layout</label>
							<config>
								<type>select</type>
								<renderType>selectSingle</renderType>
								<items>
									<numIndex index="0">
										<label>Überschrift 1</label>
										<value>1</value>
									</numIndex>
									<numIndex index="1">
										<label>Überschrift 2</label>
										<value>2</value>
									</numIndex>
									<numIndex index="2">
										<label>Überschrift 3</label>
										<value>3</value>
									</numIndex>
								</items>
								<default>2</default>
							</config>
							<displayCond>FIELD:settings.flexform.searchFormTemplate:=:Default</displayCond>
					</settings.flexform.header_layout>

				</el>
			</ROOT>
		</sTemplate>
		<sFilter>
			<ROOT>
					<sheetTitle>Filter</sheetTitle>
				<type>array</type>

				<el>
					<settings.filter.cityCollection>
							<label>Orte (Namen durch Komma getrennt)</label>
							<config>
								<type>text</type>
								<rows>3</rows>
								<cols>40</cols>
							</config>
					</settings.filter.cityCollection>


					<settings.filter.institutionCollection>
							<label>Institutionen zu Orten</label>
							<config>
								<type>user</type>
								<renderType>napiItemSelector</renderType>
								<allowed>institution</allowed>
								<minItems>0</minItems>
								<maxItems>99</maxItems>
								<size>10</size>
							</config>
					</settings.filter.institutionCollection>

					<settings.filter.pidDateFilter>
							<label>Seite mit Datumsvorlagen</label>
							<config>
								<type>group</type>
								<allowed>pages</allowed>
								<size>1</size>
								<maxitems>1</maxitems>
								<minitems>0</minitems>
								<show_thumbs>1</show_thumbs>
							</config>
					</settings.filter.pidDateFilter>

					<settings.filter.categoryCollection>
							<label>Kategorien</label>
							<config>
								<type>group</type>
								<allowed>sys_category</allowed>
								<size>10</size>
								<maxitems>99</maxitems>
								<minitems>0</minitems>
								<show_thumbs>1</show_thumbs>
							</config>
					</settings.filter.categoryCollection>

					<settings.filter.eventTypes>
							<label>Rubriken (Veranstaltungstypen) zur Auswahl</label>
							<config>
								<type>select</type>
								<renderType>selectMultipleSideBySide</renderType>
								<minitems>0</minitems>
								<maxitems>20</maxitems>
								<items>
									<numIndex index="0">
										<label>Gottesdienste</label>
										<value>church_service</value>
									</numIndex>
									<numIndex index="1">
										<label>Gremium</label>
										<value>committee</value>
									</numIndex>
									<numIndex index="2">
										<label>Sonstiges</label>
										<value>default</value>
									</numIndex>
									<numIndex index="3">
										<label>Bildung</label>
										<value>edu</value>
									</numIndex>
									<numIndex index="4">
										<label>Gemeindeleben</label>
										<value>event</value>
									</numIndex>
									<numIndex index="5">
										<label>Freizeit</label>
										<value>leisure</value>
									</numIndex>
									<numIndex index="6">
										<label>Konzert</label>
										<value>music</value>
									</numIndex>
									<numIndex index="7">
										<label>Spiritualität</label>
										<value>spirituality</value>
									</numIndex>
								</items>
							</config>
					</settings.filter.eventTypes>

					<settings.filter.autocomplete>
							<label>Suchbegriffe vorschlagen (Titel passender Veranstaltungen)</label>
							<config>
								<type>check</type>
								<default>0</default>
							</config>
					</settings.filter.autocomplete>

					<settings.flexform.presets.city>
							<label>Vorbelegung: Ort / PLZ</label>
							<config>
								<type>input</type>
								<size>30</size>
							</config>
					</settings.flexform.presets.city>

					<settings.flexform.presets.eventType>
							<label>Vorbelegung: Rubrik</label>
							<config>
								<type>select</type>
								<renderType>selectSingle</renderType>
								<items>
									<numIndex index="0">
										<label></label>
										<value></value>
									</numIndex>
									<numIndex index="1">
										<label>Gottesdienste</label>
										<value>church_service</value>
									</numIndex>
									<numIndex index="2">
										<label>Gremium</label>
										<value>committee</value>
									</numIndex>
									<numIndex index="3">
										<label>Sonstiges</label>
										<value>default</value>
									</numIndex>
									<numIndex index="4">
										<label>Bildung</label>
										<value>edu</value>
									</numIndex>
									<numIndex index="5">
										<label>Gemeindeleben</label>
										<value>event</value>
									</numIndex>
									<numIndex index="6">
										<label>Freizeit</label>
										<value>leisure</value>
									</numIndex>
									<numIndex index="7">
										<label>Konzert</label>
										<value>music</value>
									</numIndex>
									<numIndex index="8">
										<label>Spiritualität</label>
										<value>spirituality</value>
									</numIndex>
								</items>
							</config>
					</settings.flexform.presets.eventType>

				</el>
			</ROOT>
		</sFilter>
		<sPages>
			<ROOT>
					<sheetTitle>Seiten</sheetTitle>
				<type>array</type>

				<el>
					<settings.flexform.pidSingle>
							<label>Seite für Einzelansicht</label>
							<config>
								<type>group</type>
								<allowed>pages</allowed>
								<size>1</size>
								<maxitems>1</maxitems>
								<minitems>0</minitems>
								<show_thumbs>1</show_thumbs>
							</config>
					</settings.flexform.pidSingle>

					<settings.flexform.pidList>
							<label>Seite für Listenansicht</label>
							<config>
								<type>group</type>
								<allowed>pages</allowed>
								<size>1</size>
								<maxitems>1</maxitems>
								<minitems>0</minitems>
								<show_thumbs>1</show_thumbs>
							</config>
					</settings.flexform.pidList>

				</el>
			</ROOT>
		</sPages>
	</sheets>
</T3DataStructure>
